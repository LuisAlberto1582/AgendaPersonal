{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MindflowStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:Describe*",
        "cloudformation:GetTemplate",
        "cloudformation:*ChangeSet"
      ],
      "Resource": [
        "arn:aws:cloudformation:us-east-1:043484001203:stack/mindflow/*",
        "arn:aws:cloudformation:us-east-1:aws:transform/Serverless-2016-10-31"
      ]
    },
    {
      "Sid": "MindflowPasarRolALambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::043484001203:role/mindflow-api-role",
      "Condition": { "StringEquals": { "iam:PassedToService": "lambda.amazonaws.com" } }
    },
    {
      "Sid": "MindflowLambda",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:GetFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:GetPolicy",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:*Tag*"
      ],
      "Resource": "arn:aws:lambda:us-east-1:043484001203:function:mindflow-*"
    },
    {
      "Sid": "MindflowCrearUserPool",
      "Effect": "Allow",
      "Action": "cognito-idp:CreateUserPool",
      "Resource": "*"
    },
    {
      "Sid": "MindflowUserPool",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:DescribeUserPool",
        "cognito-idp:UpdateUserPool",
        "cognito-idp:*UserPoolClient",
        "cognito-idp:*UserPoolMfaConfig",
        "cognito-idp:*Tag*"
      ],
      "Resource": "arn:aws:cognito-idp:us-east-1:043484001203:userpool/*"
    }
  ]
}
